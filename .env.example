# Nabulines Academy — environment (copy to .env, never commit .env)

# Anthropic — lesson + news generation (Module 1, 4)
ANTHROPIC_API_KEY=
LESSON_MODEL=claude-sonnet-4-6

# ElevenLabs — narration TTS (Module 3)
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_MODEL=eleven_v3

# Telegram approval bot (Module 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare R2 — video hosting (Module 2/3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=academy-videos
R2_PUBLIC_BASE=https://media.nabulines.com
