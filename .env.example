# Nabulines Academy — environment (copy to .env, never commit .env)

# LLM provider — lesson + news generation (Module 1, 4)
# Default: OpenRouter (OpenAI-compatible, top up with crypto). One key, many models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick any model from openrouter.ai/models — this is the default writer model:
LESSON_MODEL=anthropic/claude-sonnet-4.5
# Alternative: direct Anthropic API (card only) — leave blank if using OpenRouter.
# ANTHROPIC_API_KEY=

# Narration TTS (Module 3) — needed only in Phase 2, not for the site.
# TTS_PROVIDER: "elevenlabs" (best quality, card only) or "local" (Kokoro/XTTS on
# the VPS, zero cost, no card — the crypto-free path).
TTS_PROVIDER=local

# ElevenLabs (card only — no crypto; fund a crypto-backed virtual card if needed)
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_MODEL=eleven_multilingual_v2
ELEVEN_SPEED=1.1

# Telegram approval bot (Module 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare R2 — video hosting (Module 2/3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=academy-videos
R2_PUBLIC_BASE=https://media.nabulines.com
